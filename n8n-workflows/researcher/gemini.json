            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ contents: [{ parts: [{ text: ($('Webhook').first().json.body.query || '') }] }], tools: [{ google_search: {} }] }) }}",
        "options": {}
      },
      "id": "h3",
      "name": "Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const msg=$json;const cands=(msg&&msg.candidates)||[];const cand=cands[0]||{};const gm=cand.groundingMetadata||{};const chunks=gm.groundingChunks||[];const seen={};const evidence=[];for(const ch of chunks){const w=ch.web||{};const url=w.uri||w.url;if(url&&!seen[url]){seen[url]=1;evidence.push({source_url:url,source_name:'gemini',content:w.title||url,freshness:null,authority:null});}}let answer='';for(const p of ((cand.content&&cand.content.parts)||[])){if(p.text)answer+=p.text;}return [{json:{status:evidence.length?'completed':'empty',source:'gemini',evidence_count:evidence.length,answer_chars:answer.length,evidence:evidence}}];"
      },
      "id": "h4",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const h=($('Webhook').first().json.headers)||{};const hdr=h['x-researcher-secret']||'';const guard=$input.first().json.guard||'';if(!guard||hdr!==guard){throw new Error('unauthorized: missing or bad X-Researcher-Secret');}return [{json:{value:$input.first().json.value}}];"
      },
