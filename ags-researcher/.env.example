# AGS Researcher worker - .env (na Mikrusie). Gitignored. Trzymaj minimalnie.
# API keys (anthropic / openai / firecrawl / manus) ZYJA w tabeli DB app_secrets -
# worker laduje je przy starcie (single source of truth). Ten plik = tylko bootstrap.

# host = kontener pg_n8n na sieci Dockera n8n_network (standalone docker run, bez compose)
POSTGRES_DSN=postgresql://ags_crd_user:PASSWORD@pg_n8n:5432/ags_crd
N8N_BASE_URL=https://ivy147-20147.mikrus.cloud

# semantic cache (pgvector live od 23/06)
SEMANTIC_CACHE_ENABLED=true

# OPCJONALNY fallback - normalnie klucze ida z app_secrets, zostaw puste:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
